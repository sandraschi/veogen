{
  "name": "@veogen/log-viewer-mcp",
  "version": "1.0.0",
  "description": "MCP server for VeoGen log viewing and debugging with natural language interface",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "bin": {
    "veogen-log-viewer-mcp": "dist/index.js"
  },
  "keywords": [
    "mcp",
    "log-viewer",
    "debugging",
    "veogen",
    "claude",
    "logs",
    "monitoring"
  ],
  "author": "VeoGen Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "zod": "^3.22.4",
    "glob": "^10.3.10",
    "tail": "^2.2.6",
    "chokidar": "^3.5.3",
    "date-fns": "^3.0.6"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "tsx": "^4.6.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/veogen/veogen",
    "directory": "tools/log-viewer-mcp"
  },
  "bugs": {
    "url": "https://github.com/veogen/veogen/issues"
  },
  "homepage": "https://github.com/veogen/veogen/tree/main/tools/log-viewer-mcp#readme",
  "mcp": {
    "name": "veogen-log-viewer",
    "description": "Natural language interface for VeoGen log viewing and debugging",
    "tools": [
      "read_logs",
      "search_logs", 
      "tail_logs",
      "get_log_stats",
      "debug_veogen",
      "watch_logs",
      "get_log_sources"
    ]
  }
}