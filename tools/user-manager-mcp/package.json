{
  "name": "@veogen/user-manager-mcp",
  "version": "1.0.0",
  "description": "MCP server for VeoGen user management with natural language interface and role-based access control",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "bin": {
    "veogen-user-manager-mcp": "dist/index.js"
  },
  "keywords": [
    "mcp",
    "user-management",
    "rbac",
    "veogen",
    "claude",
    "authentication",
    "users",
    "roles"
  ],
  "author": "VeoGen Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "zod": "^3.22.4",
    "pg": "^8.11.3",
    "bcrypt": "^5.1.1",
    "validator": "^13.11.0",
    "date-fns": "^3.0.6"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/bcrypt": "^5.0.2",
    "@types/validator": "^13.11.7",
    "typescript": "^5.3.0",
    "tsx": "^4.6.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/veogen/veogen",
    "directory": "tools/user-manager-mcp"
  },
  "bugs": {
    "url": "https://github.com/veogen/veogen/issues"
  },
  "homepage": "https://github.com/veogen/veogen/tree/main/tools/user-manager-mcp#readme",
  "mcp": {
    "name": "veogen-user-manager",
    "description": "Natural language interface for VeoGen user management with role-based access control",
    "tools": [
      "list_users",
      "get_user",
      "create_user",
      "update_user",
      "delete_user",
      "search_users",
      "get_user_stats",
      "manage_roles",
      "check_permissions",
      "get_user_activity"
    ]
  }
}