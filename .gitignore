# ---------------------------------------------------------------------------
# Fleet .gitignore template (mcp-central-docs/standards/GITIGNORE_STANDARDS.md 1b)
# ---------------------------------------------------------------------------

# Go (not in fleet yet, but when it arrives)
*.exe
*.exe~
*.dll
*.so
*.dylib
go.work
go.work.sum

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node / webapp
node_modules/
**/node_modules/
.next/
*.tsbuildinfo

# Rust / Tauri (FLEET: commonly forgotten!)
target/
native/target/
web_sota/src-tauri/target/
gen/

# Build output
dist/
build/
*.spec
*.exe
!run_server.py
*.mcpb

# MCPB pack staging (exact copy of src/ for packing - never commit)
mcpb/src/
mcpb/

# Tauri resources (PyInstaller binaries - gitignored, bundled at build)
native/resources/*.exe
native/binaries/*.exe

# Data / DB
data/
*.db
*.db-shm
*.db-wal

# Secrets
.env
.env.*
!.env.example
*.pem

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Logs
*.log
logs/

# Fleet backup artifacts
*.bak
*.bak.*

# Docker
.docker/

# ---------------------------------------------------------------------------
# veogen-specific
# ---------------------------------------------------------------------------

# Phase 0 purge (2026-08) + BUG-054: secrets, accounts, mail dumps, runtime data
credentials/
accounts/
sandra_token.txt
latest_email.eml
*.eml
dev_emails/
*.db-journal
/_archive/

# Generated media and scratch
/outputs/
/backend/outputs/
/uploads/
/backend/uploads/
/temp/
/backend/temp/
*.tmp
*.temp

# Tests / coverage / Playwright
coverage/
htmlcov/
.coverage
.coverage.*
.nyc_output/
test-results/
playwright-report/
.cache/
.parcel-cache/

# Node / editor leftovers
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
*.swp
*.swo

# Docker volumes and monitoring data
.dockerignore
postgres_data/
redis_data/
/monitoring/

# Private documentation (internal dev notes, not for public)
/docs-private/
