{
  "mcpServers": {
    "filesystem": {
      "command": "py",
      "args": ["-m", "filesystem_mcp"],
      "cwd": "D:\\Dev\\repos\\filesystem-mcp",
      "env": {
        "PYTHONPATH": "D:/Dev/repos/filesystem-mcp/src",
        "PYTHONUNBUFFERED": "1"
      },
      "description": "File system operations with extended capabilities"
    },
    "database": {
      "command": "py",
      "args": ["-m", "database_operations_mcp"],
      "cwd": "D:\\Dev\\repos\\database-operations-mcp",
      "env": {
        "SQLITE_DEFAULT_PATH": "D:\\Data",
        "PYTHONPATH": "D:/Dev/repos/database-operations-mcp/src",
        "PYTHONUNBUFFERED": "1"
      },
      "description": "Database operations with multiple backend support"
    },
    "http": {
      "command": "node",
      "args": ["dist/server.js"],
      "cwd": "D:\\Dev\\repos\\http-mcp",
      "env": {
        "NODE_ENV": "production",
        "PORT": "3000"
      },
      "description": "HTTP/HTTPS client with advanced features"
    },
    "ai": {
      "command": "python",
      "args": ["-m", "ai_mcp"],
      "cwd": "D:\\Dev\\repos\\ai-mcp",
      "env": {
        "PYTHONPATH": "D:/Dev/repos/ai-mcp/src",
        "AI_MODEL_PATH": "./models",
        "PYTHONUNBUFFERED": "1"
      },
      "description": "AI model interactions and inference"
    },
    "blender": {
      "command": "python",
      "args": ["-m", "blender_mcp"],
      "cwd": "D:\\Dev\\repos\\blender-mcp",
      "env": {
        "PYTHONPATH": "D:/Dev/repos/blender-mcp/src",
        "BLENDER_EXECUTABLE": "C:/Program Files/Blender Foundation/Blender 4.4/blender.exe",
        "PYTHONUNBUFFERED": "1"
      },
      "description": "Blender 3D integration"
    },
    "docker": {
      "command": "python",
      "args": ["-m", "dockermcp.server"],
      "cwd": "D:\\Dev\\repos\\docker-mcp",
      "env": {
        "PYTHONPATH": "D:/Dev/repos/docker-mcp/src",
        "DOCKER_HOST": "unix:///var/run/docker.sock",
        "PYTHONUNBUFFERED": "1"
      },
      "description": "Docker container management"
    },
    "fastsearch": {
      "command": "python",
      "args": ["-m", "fastsearch_mcp.server"],
      "cwd": "D:\\Dev\\repos\\fastsearch-mcp",
      "env": {
        "PYTHONPATH": "D:/Dev/repos/fastsearch-mcp",
        "LOG_LEVEL": "info",
        "MODEL_PATH": "./models",
        "PYTHONUNBUFFERED": "1"
      },
      "description": "Fast semantic search capabilities"
    },
    "local-llm": {
      "command": "python",
      "args": ["-m", "llm_mcp.main"],
      "cwd": "D:\\Dev\\repos\\local-llm-mcp",
      "env": {
        "PYTHONPATH": "D:/Dev/repos/local-llm-mcp/src",
        "LOG_LEVEL": "info",
        "MODEL_PATH": "./models",
        "PYTHONUNBUFFERED": "1"
      },
      "description": "Local LLM inference and management"
    },
    "vector-db": {
      "command": "python",
      "args": ["-m", "vectordb_mcp.server"],
      "cwd": "D:\\Dev\\repos\\vectordb-mcp",
      "env": {
        "PYTHONPATH": "D:/Dev/repos/vectordb-mcp/src",
        "STORAGE_PATH": "./data",
        "PYTHONUNBUFFERED": "1"
      },
      "description": "Vector database operations"
    },
    "web-browser": {
      "command": "node",
      "args": ["dist/server.js"],
      "cwd": "D:\\Dev\\repos\\webbrowser-mcp",
      "env": {
        "NODE_ENV": "production",
        "BROWSER_PATH": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
      },
      "description": "Automated web browser control"
    },
    "biomcp": {
      "command": "python",
      "args": ["-m", "biomcp.server"],
      "cwd": "D:\\Dev\\repos\\biomcp",
      "env": {
        "PYTHONPATH": "D:/Dev/repos/biomcp/src",
        "DATA_PATH": "./data/clinical_trials"
      },
      "description": "Biomedical research data and clinical trials"
    },
    "huggingface": {
      "command": "python",
      "args": ["-m", "huggingface_mcp"],
      "cwd": "D:\\Dev\\repos\\huggingface-mcp",
      "env": {
        "HUGGINGFACE_HUB_CACHE": "./cache/huggingface",
        "MODEL_CACHE_SIZE": "10GB"
      },
      "description": "Hugging Face models and datasets"
    },
    "nasa": {
      "command": "python",
      "args": ["-m", "nasa_mcp.server"],
      "cwd": "D:\\Dev\\repos\\nasa-mcp",
      "env": {
        "NASA_API_KEY": "${NASA_API_KEY}",
        "CACHE_DIR": "./cache/nasa"
      },
      "description": "NASA space mission data and imagery"
    },
    "scientific-computing": {
      "command": "jupyter",
      "args": ["notebook", "--no-browser", "--port=8888"],
      "cwd": "D:\\Dev\\repos\\scientific-computing",
      "env": {
        "JUPYTER_CONFIG_DIR": "./config",
        "PYTHONPATH": "D:/Dev/repos/scientific-computing/src"
      },
      "description": "Scientific computing and data analysis"
    },
    "wikipedia": {
      "command": "python",
      "args": ["-m", "wikipedia_mcp"],
      "cwd": "D:\\Dev\\repos\\wikipedia-mcp",
      "env": {
        "WIKI_CACHE_DIR": "./cache/wikipedia",
        "LANGUAGE": "en"
      },
      "description": "Wikipedia content search and retrieval"
    },
    "openai": {
      "command": "python",
      "args": ["-m", "openai_mcp.server"],
      "cwd": "D:\\Dev\\repos\\openai-mcp",
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "MODEL": "gpt-4"
      },
      "description": "OpenAI API integration"
    }
  }
}
