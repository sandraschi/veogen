<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#4f46e5">
    <meta name="description" content="AI Suite Dashboard - Manage your AI applications in one place">
    <title>AI Apps Dashboard - AI Apps Dashboard</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/static/img/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/static/img/apple-touch-icon.png">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- CSS -->
    <link rel="stylesheet" href="/static/css/dashboard.css">
    <link rel="stylesheet" href="/static/css/components.css">
    
    <!-- Preload critical resources -->
    <link rel="preload" href="/static/css/dashboard.css" as="style">
    <link rel="preload" href="/static/css/components.css" as="style">
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/webfonts/fa-solid-900.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="https://fonts.gstatic.com/s/inter/v12/UcCO3FwrK3iLTeHuS_fvQtMwCp50KnMw2boKoduKmMEVuLyfMZg.woff2" as="font" type="font/woff2" crossorigin>
    <style>
        /* Critical CSS for initial load */
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background-color: #f9fafb;
            color: #111827;
            transition: background-color 0.3s, color 0.3s;
        }
        
        /* Ensure the main content doesn't hide behind the fixed top bar */
        .main-content {
            margin-top: 60px;
            padding: 1.5rem;
            min-height: calc(100vh - 60px);
        }
        
        /* Loading state */
        .loading {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 200px;
        }
        
        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 4px solid rgba(0, 0, 0, 0.1);
            border-radius: 50%;
            border-top-color: #4f46e5;
            animation: spin 1s ease-in-out infinite;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="bg-gray-100">
    <div class="min-h-screen flex flex-col">
        <!-- Enhanced Top Bar -->
        <header class="top-bar">
            <div class="top-bar-left">
                <button id="sidebarToggle" class="hamburger-btn" title="Toggle sidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <h1 class="app-title">AI Apps Dashboard</h1>
            </div>
            
            <!-- Search Box -->
            <div class="search-box">
                <input type="text" id="globalSearch" placeholder="Search apps..." aria-label="Search applications">
                <button type="button" id="searchButton" aria-label="Search">
                    <i class="fas fa-search"></i>
                </button>
            </div>
            
            <!-- Top Bar Actions -->
            <div class="top-bar-actions">
                <!-- Theme Toggle -->
                <button id="themeToggle" class="action-btn" title="Toggle theme">
                    <i class="fas fa-moon" id="themeIcon"></i>
                </button>
                
                <!-- Font Controls -->
                <div class="font-controls">
                    <button id="decreaseFont" class="font-control-btn" title="Decrease font size">
                        <i class="fas fa-minus"></i>
                    </button>
                    <span class="font-size-display" id="fontSizeDisplay">100%</span>
                    <button id="increaseFont" class="font-control-btn" title="Increase font size">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
                
                <!-- Language Selector -->
                <div class="dropdown">
                    <button id="languageToggle" class="action-btn" type="button" aria-haspopup="true" aria-expanded="false" title="Select language">
                        <i class="fas fa-globe"></i>
                        <span id="currentLanguage">EN</span>
                    </button>
                    <ul class="dropdown-menu" role="menu" aria-labelledby="languageToggle">
                        <li><a href="#" data-lang="en" role="menuitem" tabindex="-1">English (EN)</a></li>
                        <li><a href="#" data-lang="de" role="menuitem" tabindex="-1">Deutsch (DE)</a></li>
                        <li><a href="#" data-lang="fr" role="menuitem" tabindex="-1">Français (FR)</a></li>
                        <li><a href="#" data-lang="es" role="menuitem" tabindex="-1">Español (ES)</a></li>
                    </ul>
                </div>
                
                <!-- Help Button -->
                <button id="helpBtn" class="action-btn" data-action="show-help" title="Help">
                    <i class="fas fa-question-circle"></i>
                </button>
                
                <!-- Logs Button -->
                <button id="logViewerBtn" class="action-btn" onclick="dashboard.openLogViewer('system')" title="View System Logs">
                    <i class="fas fa-scroll"></i>
                </button>
                
                <!-- Settings Button -->
                <button id="settingsBtn" class="action-btn" onclick="toggleModal('settings-modal', true)" title="Settings">
                    <i class="fas fa-cog"></i>
                </button>
                
                <!-- Last Updated -->
                <div class="text-xs text-indigo-200 ml-2 hidden md:block">
                    <span id="last-updated">Updating...</span>
                </div>
                
                <!-- User Menu (Rightmost) -->
                <div class="dropdown ml-2">
                    <button id="userMenuToggle" class="action-btn flex items-center gap-2" type="button" aria-haspopup="true" aria-expanded="false" title="User menu">
                        <i class="fas fa-user-circle text-xl"></i>
                        <span class="hidden sm:inline">User</span>
                        <i class="fas fa-chevron-down text-xs transition-transform duration-200"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-right" role="menu" aria-labelledby="userMenuToggle">
                        <li class="px-4 py-2 border-b border-gray-100 dark:border-gray-700">
                            <div class="text-xs text-gray-500 dark:text-gray-400">Signed in as</div>
                            <div class="font-medium text-sm truncate">user@example.com</div>
                        </li>
                        <li class="mt-1">
                            <a href="#" class="dropdown-item" data-action="profile" role="menuitem">
                                <i class="fas fa-user mr-2 w-4 text-center"></i> Your Profile
                            </a>
                        </li>
                        <li>
                            <a href="#" class="dropdown-item" data-action="settings" role="menuitem">
                                <i class="fas fa-cog mr-2 w-4 text-center"></i> Settings
                            </a>
                        </li>
                        <li class="border-t border-gray-100 dark:border-gray-700 mt-1 pt-1">
                            <a href="#" class="dropdown-item text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20" data-action="logout" role="menuitem">
                                <i class="fas fa-sign-out-alt mr-2 w-4 text-center"></i> Sign out
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="main-content flex-1 overflow-auto">
            <!-- Stats Cards -->
            <div class="stats-grid grid grid-cols-3 gap-4 p-4">
                <!-- CPU Usage -->
                <div class="bg-white rounded-lg shadow overflow-hidden">
                    <div class="px-4 py-3">
                        <div class="flex items-center">
                            <div class="flex-shrink-0 bg-indigo-100 p-3 rounded-full">
                                <i class="fas fa-microchip text-indigo-600 text-xl"></i>
                            </div>
                            <div class="ml-4">
                                <h3 class="text-sm font-medium text-gray-500">CPU Usage</h3>
                                <p class="text-2xl font-semibold text-gray-900" id="cpu-usage">0%</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Memory Usage -->
                <div class="bg-white rounded-lg shadow overflow-hidden">
                    <div class="px-4 py-3">
                        <div class="flex items-center">
                            <div class="flex-shrink-0 bg-green-100 p-3 rounded-full">
                                <i class="fas fa-memory text-green-600 text-xl"></i>
                            </div>
                            <div class="ml-4">
                                <h3 class="text-sm font-medium text-gray-500">Memory Usage</h3>
                                <p class="text-2xl font-semibold text-gray-900" id="memory-usage">0%</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Running Apps -->
                <div class="bg-white rounded-lg shadow overflow-hidden">
                    <div class="px-4 py-3">
                        <div class="flex items-center">
                            <div class="flex-shrink-0 bg-yellow-100 p-3 rounded-full">
                                <i class="fas fa-server text-yellow-600 text-xl"></i>
                            </div>
                            <div class="ml-4">
                                <h3 class="text-sm font-medium text-gray-500">Running Apps</h3>
                                <p class="text-2xl font-semibold text-gray-900">
                                    <span id="running-apps">0</span> / <span id="total-apps">0</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Apps Grid -->
            <div class="apps-grid" id="apps-container">
                <!-- App cards will be inserted here by JavaScript -->
            </div>
        </main>
    </div>

    <!-- App Modal -->
    <div id="app-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50">
        <div class="relative top-20 mx-auto p-5 border w-11/12 md:w-2/3 lg:w-1/2 shadow-lg rounded-md bg-white dark:bg-gray-800">
            <div class="flex justify-between items-center pb-3">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white" id="modal-title">App Details</h3>
                <button onclick="closeModal()" class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300">
                    <i class="fas fa-times text-2xl"></i>
                </button>
            </div>
            <div class="mt-4">
                <div class="mb-4">
                    <h4 class="text-lg font-medium text-gray-900 dark:text-white" id="modal-app-name"></h4>
                    <p class="text-gray-600 dark:text-gray-300 text-sm" id="modal-app-description"></p>
                </div>
                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400">Status</p>
                        <p class="font-medium dark:text-white" id="modal-app-status">-</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400">Port</p>
                        <p class="font-mono dark:text-gray-200" id="modal-app-port">-</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400">CPU Usage</p>
                        <p class="font-mono dark:text-gray-200" id="modal-app-cpu">-</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400">Memory Usage</p>
                        <p class="font-mono dark:text-gray-200" id="modal-app-memory">-</p>
                    </div>
                </div>
                <div class="border-t border-gray-200 dark:border-gray-700 pt-4">
                    <div class="flex flex-wrap gap-2 justify-end">
                        <button id="modal-logs-btn" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:bg-blue-700 dark:hover:bg-blue-600">
                            <i class="fas fa-terminal mr-2"></i>View Logs
                        </button>
                        <button id="modal-open-btn" class="px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 dark:bg-indigo-700 dark:hover:bg-indigo-600">
                            <i class="fas fa-external-link-alt mr-2"></i>Open App
                        </button>
                        <button id="modal-start-btn" class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 dark:bg-green-700 dark:hover:bg-green-600">
                            <i class="fas fa-play mr-2"></i>Start
                        </button>
                        <button id="modal-stop-btn" class="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 dark:bg-red-700 dark:hover:bg-red-600">
                            <i class="fas fa-stop mr-2"></i>Stop
                        </button>
                        <button onclick="closeModal()" class="px-4 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 dark:bg-gray-600 dark:text-white dark:hover:bg-gray-500">
                            <i class="fas fa-times mr-2"></i>Close
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Log Viewer Modal -->
    <div id="log-viewer-modal" class="modal hidden">
        <div class="modal-content">
            <div class="flex justify-between items-center pb-3 border-b border-gray-200 dark:border-gray-700">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                    <i class="fas fa-terminal mr-2"></i>Log Viewer
                </h3>
                <button onclick="closeLogViewer()" class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300">
                    <i class="fas fa-times text-2xl"></i>
                </button>
            </div>
            <div class="border-b border-gray-200 dark:border-gray-700 px-4 py-2 flex items-center justify-between bg-gray-50 dark:bg-gray-800">
                <div class="flex items-center space-x-4">
                    <div class="flex items-center">
                        <label for="log-level-filter" class="text-xs font-medium text-gray-700 dark:text-gray-300 mr-2">Level:</label>
                        <select id="log-level-filter" class="text-xs border border-gray-300 rounded px-2 py-1 bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            <option value="all">All</option>
                            <option value="debug">Debug</option>
                            <option value="info">Info</option>
                            <option value="warn">Warning</option>
                            <option value="error">Error</option>
                        </select>
                    </div>
                    <button id="clear-logs" class="text-xs text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white" title="Clear logs">
                        <i class="fas fa-trash-alt mr-1"></i> Clear
                    </button>
                </div>
                <div class="text-xs text-gray-500 dark:text-gray-400">
                    <span id="log-app-name">System</span> - Last updated: <span id="log-updated">Never</span>
                </div>
            </div>
            <div class="flex-1 overflow-hidden flex flex-col">
                <div id="log-content" class="flex-1 overflow-auto p-4 font-mono text-xs bg-gray-50 dark:bg-gray-900 dark:text-gray-200">
                    <div class="text-center text-gray-500 dark:text-gray-500 py-4">Loading logs...</div>
                </div>
            </div>
            <div class="border-t border-gray-200 dark:border-gray-700 px-4 py-3 flex justify-between items-center bg-white dark:bg-gray-800">
                <div class="flex items-center space-x-3">
                    <button id="refresh-logs" class="px-3 py-1.5 text-xs bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-md dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600 transition-colors" title="Refresh logs">
                        <i class="fas fa-sync-alt mr-1"></i> Refresh
                    </button>
                    <button id="scroll-to-bottom" class="p-1.5 text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white" title="Scroll to bottom">
                        <i class="fas fa-arrow-down"></i>
                    </button>
                    <button id="copy-logs" class="p-1.5 text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white" title="Copy logs to clipboard">
                        <i class="far fa-copy"></i>
                    </button>
                    <button id="download-logs" class="p-1.5 text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white" title="Download logs">
                        <i class="fas fa-download"></i>
                    </button>
                </div>
                <div class="text-xs text-gray-500 dark:text-gray-400">
                    <span id="log-count">0</span> entries
                </div>
                <button onclick="closeLogViewer()" class="px-4 py-1.5 text-xs bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-md dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600 transition-colors">
                    Close
                </button>
            </div>
        </div>
    </div>
    
    <!-- Settings Modal -->
    <div id="settings-modal" class="modal hidden">
        <div class="modal-content">
            <div class="flex justify-between items-center pb-3 border-b border-gray-200 dark:border-gray-700">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                    <i class="fas fa-cog mr-2"></i>Settings
                </h3>
                <button type="button" class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300" onclick="toggleModal('settings-modal', false)">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <div class="flex-1 overflow-y-auto py-4 px-6">
                <div class="space-y-6">
                    <!-- LLM Providers Section -->
                    <div>
                        <h4 class="text-lg font-medium text-gray-900 dark:text-white mb-4">LLM Providers</h4>
                        
                        <!-- Ollama Settings -->
                        <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg mb-4">
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center">
                                    <img src="/static/img/ollama-logo.png" alt="Ollama" class="h-6 w-6 mr-2">
                                    <h5 class="font-medium">Ollama</h5>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" class="sr-only peer" id="ollama-enabled">
                                    <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                                    <span class="ml-2 text-sm font-medium text-gray-700 dark:text-gray-300">Enabled</span>
                                </label>
                            </div>
                            <div id="ollama-settings" class="pl-8 space-y-3">
                                <div>
                                    <label for="ollama-endpoint" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Endpoint</label>
                                    <input type="text" id="ollama-endpoint" value="http://localhost:11434" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white">
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label for="ollama-model" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Default Model</label>
                                        <select id="ollama-model" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white">
                                            <option value="llama3">Llama 3</option>
                                            <option value="mistral">Mistral</option>
                                            <option value="codellama">CodeLlama</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label for="ollama-temperature" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Temperature</label>
                                        <input type="range" id="ollama-temperature" min="0" max="2" step="0.1" value="0.7" class="w-full">
                                        <div class="flex justify-between text-xs text-gray-500">
                                            <span>Precise</span>
                                            <span>Balanced</span>
                                            <span>Creative</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- LM Studio Settings -->
                        <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg mb-4">
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center">
                                    <img src="/static/img/lmstudio-logo.png" alt="LM Studio" class="h-6 w-6 mr-2">
                                    <h5 class="font-medium">LM Studio</h5>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" class="sr-only peer" id="lmstudio-enabled">
                                    <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                                    <span class="ml-2 text-sm font-medium text-gray-700 dark:text-gray-300">Enabled</span>
                                </label>
                            </div>
                            <div id="lmstudio-settings" class="pl-8 space-y-3">
                                <div>
                                    <label for="lmstudio-endpoint" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Endpoint</label>
                                    <input type="text" id="lmstudio-endpoint" value="http://localhost:1234" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white">
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label for="lmstudio-model" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Model</label>
                                        <input type="text" id="lmstudio-model" placeholder="Model name" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white">
                                    </div>
                                    <div>
                                        <label for="lmstudio-context" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Context Window</label>
                                        <select id="lmstudio-context" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white">
                                            <option value="2048">2K tokens</option>
                                            <option value="4096">4K tokens</option>
                                            <option value="8192">8K tokens</option>
                                            <option value="16384">16K tokens</option>
                                            <option value="32768">32K tokens</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- vLLM Settings -->
                        <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center">
                                    <img src="/static/img/vllm-logo.png" alt="vLLM" class="h-6 w-6 mr-2">
                                    <h5 class="font-medium">vLLM</h5>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" class="sr-only peer" id="vllm-enabled">
                                    <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                                    <span class="ml-2 text-sm font-medium text-gray-700 dark:text-gray-300">Enabled</span>
                                </label>
                            </div>
                            <div id="vllm-settings" class="pl-8 space-y-3">
                                <div>
                                    <label for="vllm-endpoint" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Endpoint</label>
                                    <input type="text" id="vllm-endpoint" value="http://localhost:8000" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white">
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label for="vllm-model" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Model</label>
                                        <input type="text" id="vllm-model" placeholder="Model name or path" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white">
                                    </div>
                                    <div>
                                        <label for="vllm-max-tokens" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Max Tokens</label>
                                        <input type="number" id="vllm-max-tokens" value="2048" min="1" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white">
                                    </div>
                                </div>
                                <div class="pt-2">
                                    <label for="vllm-params" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Additional Parameters</label>
                                    <textarea id="vllm-params" rows="2" placeholder='{"temperature": 0.7, "top_p": 0.9}' class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white font-mono text-sm"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="flex justify-end pt-4 border-t border-gray-200 dark:border-gray-700 px-6 pb-6">
                <button type="button" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600 dark:hover:bg-gray-600" onclick="toggleModal('settings-modal', false)">
                    Cancel
                </button>
                <button type="button" class="ml-3 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:bg-blue-700 dark:hover:bg-blue-600" onclick="saveSettings()">
                    Save Settings
                </button>
            </div>
        </div>
    </div>

    <!-- Help Modal -->
    <div id="help-modal" class="modal hidden">
        <div class="modal-content max-w-4xl p-6">
            <div class="flex justify-between items-center pb-4 border-b border-gray-200 dark:border-gray-700">
                <div class="flex items-center">
                    <div class="bg-blue-100 dark:bg-blue-900 p-3 rounded-full mr-4">
                        <i class="fas fa-question-circle text-blue-600 dark:text-blue-400 text-2xl"></i>
                    </div>
                    <div>
                        <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Help & Support</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Everything you need to know about the dashboard</p>
                    </div>
                </div>
                <button onclick="closeHelpModal()" class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300 transition-colors">
                    <i class="fas fa-times text-2xl"></i>
                </button>
            </div>
            
            <div class="flex-1 overflow-y-auto py-6 px-2 md:px-6">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <!-- Getting Started Section -->
                    <div class="space-y-6">
                        <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 p-6 rounded-xl border border-blue-200 dark:border-blue-800">
                            <div class="flex items-center mb-4">
                                <div class="bg-blue-600 p-2 rounded-lg mr-3">
                                    <i class="fas fa-rocket text-white"></i>
                                </div>
                                <h4 class="text-xl font-semibold text-gray-900 dark:text-white">Getting Started</h4>
                            </div>
                            <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                                Welcome to the AI Suite Dashboard! This is your central hub for managing all your AI applications. 
                                Each card represents an application that you can start, stop, and monitor.
                            </p>
                        </div>
                        
                        <div class="bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 p-6 rounded-xl border border-green-200 dark:border-green-800">
                            <div class="flex items-center mb-4">
                                <div class="bg-green-600 p-2 rounded-lg mr-3">
                                    <i class="fas fa-play text-white"></i>
                                </div>
                                <h4 class="text-xl font-semibold text-gray-900 dark:text-white">Application Controls</h4>
                            </div>
                            <div class="space-y-3">
                                <div class="flex items-center">
                                    <div class="w-8 h-8 bg-green-100 dark:bg-green-900 rounded-full flex items-center justify-center mr-3">
                                        <i class="fas fa-play text-green-600 dark:text-green-400 text-sm"></i>
                                    </div>
                                    <span class="text-gray-700 dark:text-gray-300">Click <strong>Start</strong> to launch an application</span>
                                </div>
                                <div class="flex items-center">
                                    <div class="w-8 h-8 bg-red-100 dark:bg-red-900 rounded-full flex items-center justify-center mr-3">
                                        <i class="fas fa-stop text-red-600 dark:text-red-400 text-sm"></i>
                                    </div>
                                    <span class="text-gray-700 dark:text-gray-300">Click <strong>Stop</strong> to shut down an application</span>
                                </div>
                                <div class="flex items-center">
                                    <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900 rounded-full flex items-center justify-center mr-3">
                                        <i class="fas fa-terminal text-blue-600 dark:text-blue-400 text-sm"></i>
                                    </div>
                                    <span class="text-gray-700 dark:text-gray-300">Click <strong>View Logs</strong> to see application logs</span>
                                </div>
                                <div class="flex items-center">
                                    <div class="w-8 h-8 bg-purple-100 dark:bg-purple-900 rounded-full flex items-center justify-center mr-3">
                                        <i class="fas fa-external-link-alt text-purple-600 dark:text-purple-400 text-sm"></i>
                                    </div>
                                    <span class="text-gray-700 dark:text-gray-300">Click <strong>Open App</strong> to access the application</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Features & Shortcuts Section -->
                    <div class="space-y-6">
                        <div class="bg-gradient-to-br from-yellow-50 to-orange-50 dark:from-yellow-900/20 dark:to-orange-900/20 p-6 rounded-xl border border-yellow-200 dark:border-yellow-800">
                            <div class="flex items-center mb-4">
                                <div class="bg-yellow-600 p-2 rounded-lg mr-3">
                                    <i class="fas fa-keyboard text-white"></i>
                                </div>
                                <h4 class="text-xl font-semibold text-gray-900 dark:text-white">Keyboard Shortcuts</h4>
                            </div>
                            <div class="space-y-3">
                                <div class="flex items-center gap-4">
                                    <span class="text-gray-700 dark:text-gray-300 flex-1">Close any modal</span>
                                    <kbd class="px-3 py-1 bg-gray-100 dark:bg-gray-700 rounded-lg text-sm font-mono border border-gray-300 dark:border-gray-600 ml-2">Esc</kbd>
                                </div>
                                <div class="flex items-center gap-4">
                                    <span class="text-gray-700 dark:text-gray-300 flex-1">Focus search box</span>
                                    <kbd class="px-3 py-1 bg-gray-100 dark:bg-gray-700 rounded-lg text-sm font-mono border border-gray-300 dark:border-gray-600 ml-2">/</kbd>
                                </div>
                                <div class="flex items-center gap-4">
                                    <span class="text-gray-700 dark:text-gray-300 flex-1">Search in logs</span>
                                    <kbd class="px-3 py-1 bg-gray-100 dark:bg-gray-700 rounded-lg text-sm font-mono border border-gray-300 dark:border-gray-600 ml-2">Ctrl + F</kbd>
                                </div>
                                <div class="flex items-center gap-4">
                                    <span class="text-gray-700 dark:text-gray-300 flex-1">Toggle theme</span>
                                    <kbd class="px-3 py-1 bg-gray-100 dark:bg-gray-700 rounded-lg text-sm font-mono border border-gray-300 dark:border-gray-600 ml-2">Ctrl + T</kbd>
                                </div>
                            </div>
                        </div>
                        
                        <div class="bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 p-6 rounded-xl border border-purple-200 dark:border-purple-800">
                            <div class="flex items-center mb-4">
                                <div class="bg-purple-600 p-2 rounded-lg mr-3">
                                    <i class="fas fa-lightbulb text-white"></i>
                                </div>
                                <h4 class="text-xl font-semibold text-gray-900 dark:text-white">Pro Tips</h4>
                            </div>
                            <ul class="space-y-2 text-gray-700 dark:text-gray-300">
                                <li class="flex items-start">
                                    <i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i>
                                    <span>Use the search bar to quickly find applications</span>
                                </li>
                                <li class="flex items-start">
                                    <i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i>
                                    <span>Monitor system resources in the stats cards</span>
                                </li>
                                <li class="flex items-start">
                                    <i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i>
                                    <span>Check logs for troubleshooting issues</span>
                                </li>
                                <li class="flex items-start">
                                    <i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i>
                                    <span>Use the settings panel to configure LLM providers</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                
                <!-- Support Section -->
                <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
                    <div class="bg-gradient-to-r from-indigo-50 to-blue-50 dark:from-indigo-900/20 dark:to-blue-900/20 p-6 rounded-xl border border-indigo-200 dark:border-indigo-800">
                        <div class="flex items-center mb-4">
                            <div class="bg-indigo-600 p-2 rounded-lg mr-3">
                                <i class="fas fa-headset text-white"></i>
                            </div>
                            <h4 class="text-xl font-semibold text-gray-900 dark:text-white">Need Help?</h4>
                        </div>
                        <p class="text-gray-700 dark:text-gray-300 mb-4">
                            If you encounter any issues or have questions, our support team is here to help.
                        </p>
                        <div class="flex flex-wrap gap-3">
                            <a href="mailto:support@example.com" class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors">
                                <i class="fas fa-envelope mr-2"></i>
                                Contact Support
                            </a>
                            <a href="#" class="inline-flex items-center px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                                <i class="fas fa-book mr-2"></i>
                                Documentation
                            </a>
                            <a href="#" class="inline-flex items-center px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                                <i class="fab fa-github mr-2"></i>
                                GitHub Issues
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="border-t border-gray-200 dark:border-gray-700 pt-4 flex justify-end">
                <button onclick="closeHelpModal()" class="px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 dark:bg-indigo-700 dark:hover:bg-indigo-600 transition-colors font-medium">
                    <i class="fas fa-check mr-2"></i>
                    Got it, thanks!
                </button>
            </div>
        </div>
    </div>

    <!-- Socket.IO -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.0.1/socket.io.js"></script>
    <!-- JavaScript -->
    <script src="/static/js/dashboard.js" defer></script>
    
    <!-- Initialize dashboard -->
    <script>
        // Set loading state until dashboard initializes
        document.addEventListener('DOMContentLoaded', () => {
            document.body.classList.add('loading');
        });
    </script>

    <!-- Initialize Socket.IO -->
    <script>
        const socket = io();
        let currentAppId = null;

        // Update the UI when status updates are received
        socket.on('status_update', function(data) {
            updateDashboard(data.apps);
        });

        // Request initial status
        socket.emit('get_status');

        // Refresh button
        document.getElementById('refresh-btn').addEventListener('click', function() {
            socket.emit('get_status');
        });

        // Update the dashboard with the latest app status
        function updateDashboard(apps) {
            const container = document.getElementById('apps-container');
            if (!container) return;

            // Update stats
            let runningCount = 0;
            let totalCpu = 0;
            let totalMemory = 0;
            let appCount = apps.length;

            // Generate app cards
            const cards = apps.map(app => {
                const isRunning = app.running;
                if (isRunning) {
                    runningCount++;
                    totalCpu += app.cpu_percent || 0;
                    totalMemory += app.memory_percent || 0;
                }

                return `
                    <div class="app-card">
                        <div>
                            <!-- First Row: Name, Status, Port, and Buttons -->
                            <div class="flex items-center justify-between">
                                <!-- Left side: Name, Status, Port -->
                                <div class="flex items-center">
                                    <h3>${app.name}</h3>
                                    
                                    <!-- Status Badge -->
                                    <div class="status-badge">
                                        <span class="status-dot ${isRunning ? 'status-running' : 'status-stopped'}"></span>
                                        <span class="${isRunning ? 'text-green-600' : 'text-red-600'}">
                                            ${isRunning ? 'Running' : 'Stopped'}
                                        </span>
                                    </div>
                                    
                                    <!-- Port Number -->
                                    <span class="port-info">Port: ${app.port}</span>
                                </div>
                                
                                <!-- Action Buttons -->
                                <div class="card-actions">
                                    <button onclick="openAppModal('${app.id}')" class="action-btn" title="Configure">
                                        <i class="fas fa-cog"></i>
                                    </button>
                                    ${isRunning ? `
                                        <button onclick="stopApp('${app.id}')" class="action-btn" title="Stop">
                                            <i class="fas fa-stop"></i>
                                        </button>
                                        <a href="http://localhost:${app.port}" target="_blank" class="action-btn" title="Open in new tab">
                                            <i class="fas fa-external-link-alt"></i>
                                        </a>
                                    ` : `
                                        <button onclick="startApp('${app.id}')" class="action-btn" title="Start">
                                            <i class="fas fa-play"></i>
                                        </button>
                                    `}
                                </div>
                            </div>
                            
                            <!-- App Description -->
                            <p class="card-description">${app.description || 'No description available'}</p>
                        </div>
                    </div>
                `;
            });

            // Update the UI
            container.innerHTML = cards.join('');

            // Update stats
            document.getElementById('running-apps').textContent = runningCount;
            document.getElementById('total-apps').textContent = appCount;
            document.getElementById('cpu-usage').textContent = runningCount > 0 ? (totalCpu / runningCount).toFixed(1) + '%' : '0%';
            document.getElementById('memory-usage').textContent = runningCount > 0 ? (totalMemory / runningCount).toFixed(1) + '%' : '0%';

            // Update last updated time
            const now = new Date();
            document.getElementById('last-updated').textContent = `Last updated: ${now.toLocaleTimeString()}`;
        }

        // App control functions
        function startApp(appId) {
            fetch(`/api/apps/${appId}/start`, { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    console.log('App started:', data);
                    socket.emit('get_status');
                })
                .catch(error => console.error('Error starting app:', error));
        }

        function stopApp(appId) {
            fetch(`/api/apps/${appId}/stop`, { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    console.log('App stopped:', data);
                    socket.emit('get_status');
                })
                .catch(error => console.error('Error stopping app:', error));
        }

        // Modal functions
        function openAppModal(appId) {
            currentAppId = appId;
            const modal = document.getElementById('app-modal');
            const app = Array.from(document.querySelectorAll('.app-card')).find(card => 
                card.querySelector('button').getAttribute('onclick').includes(`'${appId}'`)
            );

            if (!app) return;

            // Populate modal with app data
            document.getElementById('modal-title').textContent = app.querySelector('h3').textContent;
            document.getElementById('modal-app-name').textContent = app.querySelector('h3').textContent;
            document.getElementById('modal-app-description').textContent = app.querySelector('p').textContent;
            document.getElementById('modal-app-status').innerHTML = app.querySelector('.status-dot').outerHTML + ' ' + 
                app.querySelector('span.text-green-600, span.text-red-600').textContent;
            document.getElementById('modal-app-port').textContent = app.querySelector('.font-mono').textContent;
            
            const cpuText = app.querySelectorAll('div > p')[3].textContent;
            const memoryText = app.querySelectorAll('div > p')[5].textContent;
            document.getElementById('modal-app-cpu').textContent = cpuText;
            document.getElementById('modal-app-memory').textContent = memoryText;

            // Update button states
            const isRunning = app.querySelector('.status-running');
            document.getElementById('modal-start-btn').classList.toggle('hidden', isRunning);
            document.getElementById('modal-stop-btn').classList.toggle('hidden', !isRunning);
            document.getElementById('modal-open-btn').classList.toggle('hidden', !isRunning);

            // Set up button handlers
            document.getElementById('modal-start-btn').onclick = () => {
                startApp(appId);
                closeModal();
            };
            document.getElementById('modal-stop-btn').onclick = () => {
                stopApp(appId);
                closeModal();
            };
            document.getElementById('modal-open-btn').onclick = () => {
                window.open(`http://localhost:${app.port}`, '_blank');
            };

            // Show modal
            modal.classList.remove('hidden');
        }


        function closeModal() {
            document.getElementById('app-modal').classList.add('hidden');
        }

        // Close modal when clicking outside (fallback if modal.js fails)
        window.onclick = function(event) {
            const modal = document.getElementById('app-modal');
            if (event.target === modal) {
                closeModal();
            }
        };

        // Keyboard shortcuts (fallback if modal.js fails)
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const openModal = document.querySelector('.modal:not(.hidden)');
                if (openModal) {
                    openModal.classList.add('hidden');
                    document.body.style.overflow = '';
                }
            }
        });
        
        // Toggle modal visibility
        function toggleModal(modalId, show = true) {
            const modal = document.getElementById(modalId);
            if (!modal) return;
            
            if (show) {
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
                // Focus the first focusable element
                const focusable = modal.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
                if (focusable) focusable.focus();
            } else {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }
        
        // Help button handler
        document.getElementById('helpBtn')?.addEventListener('click', () => {
            toggleModal('help-modal');
        });
        
        // Log viewer button handler
        document.getElementById('logViewerBtn')?.addEventListener('click', () => {
            if (window.dashboard) {
                window.dashboard.openLogViewer('system');
            } else {
                console.error('Dashboard not initialized');
            }
        });
        
        // Global function to close log viewer
        window.closeLogViewer = function() {
            if (window.dashboard) {
                window.dashboard.closeLogViewer();
            }
        };
        
        // Global function to close help modal
        window.closeHelpModal = function() {
            const helpModal = document.getElementById('help-modal');
            if (helpModal) {
                helpModal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        };
        
        // Close buttons for all modals
        document.querySelectorAll('[data-dismiss="modal"]').forEach(button => {
            button.addEventListener('click', () => {
                const modal = button.closest('.modal');
                if (modal) {
                    toggleModal(modal.id, false);
                }
            });
        });
        
        // Close modal when clicking outside content
        document.querySelectorAll('.modal').forEach(modal => {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    toggleModal(modal.id, false);
                }
            });
        });
    </script>
    
    <!-- Debug Overlay Detection -->
    <script src="/static/js/debug-overlay.js"></script>
    
    <!-- Temporary styles to help identify the overlay -->
    <style>
        /* Make sure the modal is hidden initially */
        #app-modal {
            display: none !important;
        }
        
        /* Add a red border to all elements for debugging */
        * {
            outline: 1px solid rgba(255, 0, 0, 0.1) !important;
        }
        
        /* Highlight potential overlay elements */
        [class*="overlay"],
        [class*="backdrop"],
        [class*="modal"],
        [style*="background"],
        [style*="opacity"] {
            outline: 2px solid #00ff00 !important;
            box-shadow: 0 0 0 2px #00ff00 !important;
        }
    </style>
    
    <!-- JavaScript -->
    <script src="/static/js/topbar.js"></script>
    <script src="/static/js/modal.js"></script>
    <script src="/static/js/dashboard.js"></script>
    
    <script>
        // Force remove any potential overlays on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Remove any elements that might be causing the overlay
            const overlays = document.querySelectorAll('.overlay, .backdrop, .modal-backdrop, .modal-curtain, [role="presentation"][style*="background"], [style*="background"][style*="opacity"]');
            overlays.forEach(el => {
                console.log('Removing overlay element:', el);
                el.remove();
            });
            
            // Make sure body and html don't have any background or overlay styles
            document.body.style.background = 'transparent';
            document.documentElement.style.background = 'transparent';
            
            // Ensure no fixed/absolute positioned elements are covering the page
            const fixedElements = document.querySelectorAll('*[style*="position: fixed"], *[style*="position:absolute"]');
            fixedElements.forEach(el => {
                const rect = el.getBoundingClientRect();
                if (rect.width >= window.innerWidth * 0.9 && rect.height >= window.innerHeight * 0.9) {
                    console.log('Large fixed/absolute element found:', el);
                    el.style.outline = '4px solid red !important';
                }
            });
        });
    </script>
</body>
</html>