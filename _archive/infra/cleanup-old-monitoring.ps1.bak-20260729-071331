# Cleanup script to remove old monitoring containers from veogen
# Run this after restarting Docker Desktop if needed

Write-Host "Removing old veogen monitoring containers..." -ForegroundColor Cyan

$containers = @(
    "veogen-grafana-1",
    "veogen-loki-1", 
    "veogen-promtail-1",
    "veogen-prometheus-1",
    "veogen-alertmanager-1",
    "veogen-node-exporter-1",
    "veogen-cadvisor-1"
)

foreach ($container in $containers) {
    Write-Host "Removing $container..." -ForegroundColor Yellow
    docker rm -f $container 2>&1 | Out-Null
    if ($LASTEXITCODE -eq 0) {
        Write-Host "  âœ“ Removed $container" -ForegroundColor Green
    } else {
        Write-Host "  âœ- $container not found or already removed" -ForegroundColor Gray
    }
}

Write-Host "`nCleaning up unused volumes..." -ForegroundColor Cyan
docker volume prune -f | Out-Null

Write-Host "`nDone! Old monitoring containers removed." -ForegroundColor Green
Write-Host "You can now run 'docker compose up -d' to start only the required services." -ForegroundColor Cyan

