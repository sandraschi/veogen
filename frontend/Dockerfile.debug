# Debug Dockerfile for Veogen Frontend
# Simplified version to test build process
FROM node:18.16.0-alpine AS build

# Set working directory
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package*.json ./

# Show package info for debugging
RUN echo "=== Package.json contents ===" && cat package.json

# Install dependencies with verbose output
RUN npm config set loglevel verbose
RUN npm install --legacy-peer-deps --no-audit

# Copy source files
COPY . .

# Show source files for debugging
RUN echo "=== Source directory ===" && ls -la src/

# Build with verbose output
ENV NODE_OPTIONS=--openssl-legacy-provider
ENV GENERATE_SOURCEMAP=false
RUN echo "=== Starting React build ===" && npm run build -- --verbose

# Show build results
RUN echo "=== Build directory ===" && ls -la build/ && echo "=== Build contents ===" && find build -type f | head -20

# Production stage with simple nginx config
FROM nginx:1.23.4-alpine

# Copy built assets
COPY --from=build /app/build /usr/share/nginx/html

# Show what was copied
RUN echo "=== Final nginx directory ===" && ls -la /usr/share/nginx/html/

# Create a basic nginx config that works
RUN echo 'server {
    listen 3000;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}' > /etc/nginx/conf.d/default.conf

# Remove the default nginx config
RUN rm -f /etc/nginx/conf.d/default.conf.dpkg-dist

EXPOSE 3000

# Add a simple startup script for debugging
RUN echo '#!/bin/sh
echo "=== Startup Debug ==="
echo "Nginx config:"
cat /etc/nginx/conf.d/default.conf
echo ""
echo "HTML directory contents:"
ls -la /usr/share/nginx/html/
echo ""
echo "Starting nginx..."
nginx -g "daemon off;"
' > /start-debug.sh && chmod +x /start-debug.sh

CMD ["/start-debug.sh"]