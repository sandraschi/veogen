# VeoGen Environment Configuration
# Copy this file to .env and update with your actual values.
# Config is read from backend/.env, falling back to the repo-root .env.

# ============================================================================
# SERVER
# ============================================================================
HOST=127.0.0.1
PORT=11150
FRONTEND_PORT=11151
DEBUG=false

# JWT signing key - MUST be a random string >= 32 chars for any shared
# deployment (the default "change-me-in-env" triggers a security warning).
SECRET_KEY=change-me-to-a-random-string-of-32-plus-chars

# SQLite by default (file lives in backend/). Override for Postgres:
# DATABASE_URL=postgresql://user:pass@host:5432/veogen

# ============================================================================
# GOOGLE / GEMINI
# ============================================================================
# At least one key is required for chat / movie scripts to work.
# IMPORTANT: if you committed an old key to git, revoke and regenerate it.
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Model IDs - optional overrides. Defaults live in app/config.py and were
# verified against https://ai.google.dev/gemini-api/docs/models on 2026-10-13.
# GEMINI_PRO_MODEL=gemini-3.1-pro-preview
# GEMINI_FLASH_MODEL=gemini-3.8-flash
# GEMINI_FLASH_LITE_MODEL=gemini-3.5-flash-lite
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# VEO_MODEL=veo-3.1-generate-preview
# VEO_LITE_MODEL=veo-3.1-lite-generate-preview
# LYRIA_MODEL=lyria-3.5
# LYRIA_CLIP_MODEL=lyria-3-clip-preview
# IMAGEN_MODEL=gemini-3.1-flash-image
